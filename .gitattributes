# Auto-detect text files and normalize line endings
* text=auto

# Zig source
*.zig text

# Shell scripts
*.sh text eol=lf

# Markdown / config
*.md text
*.yml text
*.json text

# FASTA test fixtures
*.fasta text
*.fa text
*.fai text

# Exclude benchmark infrastructure and wrapper crates from language stats
bench/** linguist-vendored
tools/noodles_wrapper/** linguist-vendored
tools/rustbio_wrapper/** linguist-vendored
