# Auto-detect text files and normalize line endings
* text=auto

# Zig source
*.zig text

# Shell scripts
*.sh text eol=lf

# Markdown / config
*.md text
*.yml text
*.json text

# FASTA fixtures: LF on every checkout (Windows must not inject \r)
*.fasta text eol=lf
*.fa text eol=lf
*.fai text eol=lf

# Exact-byte exceptions: intentional CRLF / corrupt .fai (must clear text AND eol)
tests/data/validator_indexer_agreement.fasta -text -eol
tests/data/gates/*.fai -text -eol
bench/index/messy_fixtures/mixed_crlf_lf.fasta -text -eol
bench/shared/messy_perf/crlf_endings.fasta -text -eol

# Exclude benchmark infrastructure and wrapper crates from language stats
bench/** linguist-vendored
tools/noodles_wrapper/** linguist-vendored
tools/rustbio_wrapper/** linguist-vendored
