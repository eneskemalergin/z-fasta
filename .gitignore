bench/index/edge_cases/

# Benchmark results (raw data is regenerated; keep figures for REPORT.md)
bench/index/results/*
!bench/index/results/figures/
bench/get/results/*
!bench/get/results/figures/
bench/stats/results/*
!bench/stats/results/figures/
bench/perf-recovery/results/*

# Performance baselines (machine-local snapshots; use bench/save_baseline.py)
bench/baselines/

# Temp dirs from verify scripts
bench/get/.verify_tmp/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

