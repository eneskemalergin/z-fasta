zig-*/

# Local tools (samtools, seqkit - download separately)
tools/

# Local zig wrapper (uses project-local zig installation)
/zig

# Editor
.vscode/
*.swp
*~

# Real datasets (download with bench/shared/download_data.sh)
bench/shared/data/

