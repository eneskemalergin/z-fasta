# Zig
zig-out/
zig-cache/
.zig-cache/
zig-*/
/zig

# Editor
.vscode/
*.swp
*~

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Tool binaries / build outputs (source under tools/ stays tracked)
tools/fastahack-*/
tools/seqkit
tools/seqtk/
tools/zebrac
tools/*/target/

# Bench: downloads, on-demand fixtures, raw results (keep figures for REPORT.md)
# Use results/* (not **) so !figures/ can re-include; ** blocks parent re-include.
bench/*/data/**
bench/index/edge_cases/
bench/*/results/*
!bench/*/results/figures/
bench/shared/cache/**
bench/baselines/
bench/*/.verify*/
bench/*/.fixture*/
bench/*/.bench*/

# Generated indexes (testing / local runs)
*.fai
!tests/data/gates/*.fai
*.zfi

# Local-only dev folders
tmp/
ref/
temp/
plan/
assets/
experiments/
