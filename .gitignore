# Zig build artifacts
zig-out/
zig-cache/
.zig-cache/

# Local Zig installation (download separately)
zig-*/

# Downloaded tool binaries (prebuilt, not built from source)
tools/fastahack-*/
tools/seqkit
tools/seqtk/
tools/zebrac

# Rust wrapper build artifacts (source is tracked)
tools/*/target/

# Local zig wrapper (uses project-local zig installation)
/zig

# Editor
.vscode/
*.swp
*~

# Real datasets (download with bench/shared/download_data.sh)
bench/shared/data/

# Generated bench data (created by bench scripts)
bench/index/data/
bench/index/edge_cases/

# Benchmark results (raw data is regenerated; keep figures for REPORT.md)
bench/index/results/*
!bench/index/results/figures/
bench/get/results/*
!bench/get/results/figures/
bench/stats/results/*
!bench/stats/results/figures/

# Performance baselines (machine-local snapshots; use bench/save_baseline.py)
bench/baselines/

# Temp dirs from verify scripts
bench/get/.verify*
bench/get/.bench*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Ignored folders
plan/
assets/

# Experiments (dev only; track harness scripts, not local data/results)
experiments/*
!experiments/25g_index_stress/
experiments/25g_index_stress/data/
experiments/25g_index_stress/results/

# Index files (generated during testing)
*.fai
*.zfi
